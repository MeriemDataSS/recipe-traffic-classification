# TRAIN / TEST SPLIT
# ==============================
set.seed(123)
# The stratification is done on the factor version of the target: for a numeric 0/1 variable,
# rsample would bin the values into quartiles and the stratification would not be effective.
indices <- initial_split(data,
prop = 0.7,
strata = traffic_fact)
train <- training(indices)
test <- testing(indices)
# Check: both sets must have the same class proportions as the full data
